Bootstrap: docker
From: ubuntu:24.04

# =============================================================================
# Apptainer definition file - OpenCode + Ollama on Ubuntu 24.04 / AMD GPU
#
# Build (requires root or fakeroot):
#   apptainer build opencode-ollama-amd.sif opencode-ollama-amd.def
#
# Run interactive TUI (single-shot):
#   apptainer run --rocm \
#     --bind $(pwd)/root-home:/root \
#     --bind $(pwd):/workspace \
#     opencode-ollama-amd.sif
#
# Run as a persistent background instance:
#   apptainer instance start --rocm \
#     --bind $(pwd)/root-home:/root \
#     --bind $(pwd):/workspace \
#     opencode-ollama-amd.sif ollama-svc
#
#   apptainer exec instance://ollama-svc ollama launch opencode
#
#   apptainer instance stop ollama-svc
# =============================================================================

# -----------------------------------------------------------------------------
# %files - copy helper scripts into the image at build time
# -----------------------------------------------------------------------------
%files
    entrypoint.sh       /opt/opencode/entrypoint.sh

# -----------------------------------------------------------------------------
# %post - runs as root inside the build environment
# -----------------------------------------------------------------------------
%post
    export DEBIAN_FRONTEND=noninteractive
    export TZ=UTC

    # Base packages
    apt-get update && apt-get install -y --no-install-recommends \
        curl \
        wget \
        ca-certificates \
        gnupg \
        lsb-release \
        ncurses-term \
        locales \
        git \
        dnsutils \
        zstd \
        pciutils \
        python3 \
        python3-pip \
        python3-venv \
        && rm -rf /var/lib/apt/lists/*

    # Locale
    locale-gen en_US.UTF-8

    # Node.js 22 LTS
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
    apt-get update && apt-get install -y --no-install-recommends nodejs
    rm -rf /var/lib/apt/lists/*

    # OpenCode
    npm install -g opencode-ai

    # Ollama base CLI plus the ROCm runtime payload. The generic install script
    # only layers in ROCm when it can see an AMD GPU at install time, which is
    # not true during an Apptainer build.
    case "$(uname -m)" in
        x86_64) OLLAMA_ARCH=amd64 ;;
        aarch64|arm64) OLLAMA_ARCH=arm64 ;;
        *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
    esac

    mkdir -p /usr/local/bin /usr/local/lib/ollama
    curl -fsSL "https://ollama.com/download/ollama-linux-${OLLAMA_ARCH}.tgz" \
        | tar -xzf - -C /usr/local
    curl -fsSL "https://ollama.com/download/ollama-linux-${OLLAMA_ARCH}-rocm.tar.zst" \
        | zstd -d \
        | tar -xf - -C /usr/local

    ln -sf /usr/local/ollama /usr/local/bin/ollama

    # Make entrypoint executable
    chmod +x /opt/opencode/entrypoint.sh

    # Create a fixed directory for helper scripts
    mkdir -p /opt/opencode

# -----------------------------------------------------------------------------
# %environment - variables available at runtime (every invocation)
# -----------------------------------------------------------------------------
%environment
    export LANG=en_US.UTF-8
    export LANGUAGE=en_US:en
    export LC_ALL=en_US.UTF-8
    export HOME=/root
    export OLLAMA_MODELS=/root/.ollama/models
    # Server listens only on localhost; clients connect to 127.0.0.1
    export OLLAMA_HOST=127.0.0.1:11434
    export OLLAMA_NUM_PARALLEL=${OLLAMA_NUM_PARALLEL:-4}
    export OLLAMA_MAX_LOADED_MODELS=${OLLAMA_MAX_LOADED_MODELS:-2}
    export OLLAMA_KEEP_ALIVE=${OLLAMA_KEEP_ALIVE:-5m}
    # AMD GPU selection can be limited at runtime if needed.
    export HIP_VISIBLE_DEVICES=${HIP_VISIBLE_DEVICES:-all}
    export ROCR_VISIBLE_DEVICES=${ROCR_VISIBLE_DEVICES:-all}

# -----------------------------------------------------------------------------
# %runscript - executed by `apptainer run` (interactive TUI use case)
# -----------------------------------------------------------------------------
%runscript
    exec /opt/opencode/entrypoint.sh "$@"

# -----------------------------------------------------------------------------
# %startscript - executed by `apptainer instance start` (background use case)
# Starts ollama serve, waits until the API is ready, then keeps the instance
# alive. Connect with: apptainer exec instance://<name> ollama launch opencode
# -----------------------------------------------------------------------------
%startscript
    ollama serve &
    OLLAMA_PID=$!

    echo "[ollama] Waiting for Ollama to be ready..."
    elapsed=0
    until curl -sf http://127.0.0.1:11434/ > /dev/null 2>&1; do
        if [ "$elapsed" -ge "${WAIT_TIMEOUT:-60}" ]; then
            echo "[ollama] ERROR: Ollama did not become ready within ${WAIT_TIMEOUT:-60}s." >&2
            exit 1
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
    echo "[ollama] Ollama is ready (${elapsed}s)."

    wait $OLLAMA_PID

# -----------------------------------------------------------------------------
# %labels - image metadata
# -----------------------------------------------------------------------------
%labels
    org.opencontainers.image.title       "OpenCode + Ollama"
    org.opencontainers.image.description "OpenCode TUI with local Ollama inference on AMD GPUs via ROCm"
    org.opencontainers.image.base        "ubuntu:24.04"

# -----------------------------------------------------------------------------
# %help - shown by `apptainer run-help opencode-ollama-amd.sif`
# -----------------------------------------------------------------------------
%help
    OpenCode + Ollama on Ubuntu 24.04 with AMD GPU support via ROCm.

    Interactive TUI (most common):
      apptainer run --rocm \
        --bind $(pwd)/root-home:/root \
        --bind $(pwd):/workspace \
        opencode-ollama-amd.sif

    Pull a model on first start:
      OLLAMA_MODEL=mistral-medium-3.5 apptainer run --rocm \
        --bind $(pwd)/root-home:/root \
        --bind $(pwd):/workspace \
        opencode-ollama-amd.sif

    Run as a background instance (Ollama daemon only):
      export OPENCODE_HOME=_my_path

      apptainer instance start --rocm \
        --bind $OPENCODE_HOME:/root/ \
        --bind $(pwd):/workspace \
        opencode-ollama-amd.sif ollama-svc

      apptainer exec instance://ollama-svc ollama launch opencode

      apptainer instance stop ollama-svc

    Typical host devices exposed by --rocm include /dev/kfd and /dev/dri.
    If you need to limit visible GPUs, set HIP_VISIBLE_DEVICES or
    ROCR_VISIBLE_DEVICES before running Apptainer.

    Show this help:
      apptainer run-help opencode-ollama-amd.sif
